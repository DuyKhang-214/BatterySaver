<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Luôn dùng nền đen + vàng, không phụ thuộc chế độ sáng/tối của máy -->
    <style name="Base.Theme.BatterySaver" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/gold_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/gold</item>
        <item name="colorOnSecondaryContainer">@color/black</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainer">@color/nav_bg</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorOutline">@color/gold_stroke</item>
        <item name="colorControlNormal">@color/gold</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.BatterySaver" parent="Base.Theme.BatterySaver" />

    <style name="Text.Section" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
